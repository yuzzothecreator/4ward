# ─── Database (PostgreSQL / Supabase) ────────────────────────
# Prefer Session pooler (port 5432) on IPv4 networks.
# Direct db.<ref>.supabase.co is often IPv6-only and fails with ENOTFOUND.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DATABASE_POOL_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# ─── Clerk Authentication ────────────────────────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/welcome
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/welcome

# ─── Stripe Payments (optional card checkout) ────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── ClickPesa (Tanzania mobile money — primary) ─────────────
# https://merchant.clickpesa.com → Settings → Developers → Applications
# Create an API application with Collection (USSD Push) enabled.
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
# Optional — only if checksum is enabled on the application
CLICKPESA_CHECKSUM_KEY=
# Webhook URL to set in ClickPesa app settings:
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/clickpesa
# Events: PAYMENT RECEIVED, PAYMENT FAILED

# ─── Admin security (production) ─────────────────────────────
# Bootstrap securely:
#   npm run admin:bootstrap -- --email you@company.com
# Or with your own password (12+ chars):
#   npm run admin:bootstrap -- --email you@company.com --password "YourStrongPass!"
ADMIN_EMAIL=you@company.com
ADMIN_EMAILS=you@company.com
# Optional client hint for UI (same as ADMIN_EMAIL)
NEXT_PUBLIC_ADMIN_EMAIL=you@company.com
# HMAC secret for admin session tokens (32+ random chars — never commit real values)
ADMIN_SESSION_SECRET=
# scrypt password hash for password-based admin session (created by bootstrap)
ADMIN_PASSWORD_HASH=
# With Clerk: also set publicMetadata.role = "ADMIN" on this user in Clerk Dashboard

# ─── Supabase Storage ────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future African gateways (optional — ClickPesa covers M-Pesa etc.)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# AZAMPAY_APP_NAME=
# SELCOM_API_KEY=
